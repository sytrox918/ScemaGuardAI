# SchemaGuard AI - Environment Variables
# Copy to .env.local for local development. Set in Vercel project settings for deployment.
# Note: Never prefix inference secrets with NEXT_PUBLIC_!

# Cloudflare Quick Tunnel URL pointing to your Kaggle FastAPI proxy (port 30001)
SGLANG_BASE_URL=https://YOUR-KAGGLE-PROXY.trycloudflare.com

# Authentication token matching SCHEMAGUARD_PROXY_TOKEN in Kaggle
SGLANG_API_TOKEN=YOUR_ACTUAL_PROXY_SECRET

# SGLang Model Identifiers
BASE_MODEL_ID=Qwen/Qwen3-1.7B
TUNED_MODEL_ID=schemaguard
